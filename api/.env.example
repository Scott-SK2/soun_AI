# ── LLM Backend ───────────────────────────────────────────────────────────
# "openai"  → GPT-4o (needs OPENAI_API_KEY)
# "local"   → Phi-3 Mini GGUF (free, needs LOCAL_MODEL_PATH)
LLM_BACKEND=openai

# ── OpenAI (if LLM_BACKEND=openai) ───────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Phi-3 Mini local (if LLM_BACKEND=local) ──────────────────────────────
# LOCAL_MODEL_PATH=./models/Phi-3-mini-4k-instruct-q4.gguf
# LOCAL_N_CTX=4096
# LOCAL_N_THREADS=4
